PORT=3000
# 仅为占位示例；替换为维护者提供的服务端连接串，不添加 VITE_ 前缀。
DATABASE_URL=
# DATABASE_URL 为空时才使用 POSTGRES_URL；已有占位值也会优先使用，需替换或清空。
# POSTGRES_URL 可由托管集成提供。二者均缺失时程序回退本机开发地址。
# 测试使用独立 .env.test.local 并设置 DOTENV_CONFIG_PATH，详见 docs/TESTING.md。
DATABASE_SSL=true
DB_POOL_MAX=1
# 学习证据导入/撤回工具要求显式注入此变量；工具不自动读取 .env，也不回退 DATABASE_URL。
# 优先在独立测试环境验证；不要在命令参数、日志或前端中放连接串。
LEARNING_IMPORT_DATABASE_URL=
# 独立验证专用变量：由测试窗口显式注入，测试工具不读取此文件。
# 只允许 loopback 专用库，结构/服务测试使用事务，探索浏览器测试另建本次随机库。
EXPLORATION_TEST_DATABASE_URL=
EXPLORATION_SERVICE_TEST_DATABASE_URL=
EXPLORATION_UI_TEST_DATABASE_URL=

# 仅用于 deploy/server/compose.yaml 的服务器私密发布文件，不是本地开发要求。
# 密码需服务器随机生成且URL安全；实际值不进入Git。
POSTGRES_PASSWORD=
RELEASE_ID=
HTTP_PORT=18088
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
